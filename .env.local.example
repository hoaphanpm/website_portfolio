# Copy this file to .env.local (gitignored) and fill in real values.
# Never commit .env.local. Never add a service-role/secret key here or
# anywhere else in this app — see docs/architecture.md §1 ("No service-role
# key anywhere in the app. Authorization comes from RLS plus the caller's
# own identity.").

# For local development: run `supabase start` (see supabase/README.md) and
# copy API_URL and PUBLISHABLE_KEY from its output.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Mixpanel project token (Settings > Project Settings in Mixpanel). Public by
# design — this is a client-side write-only token, not a secret. Analytics
# stays fully disabled whenever this is unset, including in local dev, since
# VERCEL_ENV is never "production" locally regardless of this value.
NEXT_PUBLIC_MIXPANEL_TOKEN=
